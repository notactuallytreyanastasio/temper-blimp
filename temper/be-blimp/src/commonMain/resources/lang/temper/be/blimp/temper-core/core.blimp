# temper-core for Blimp.
#
# Blimp and Temper disagree in three places, and this file is the bridge:
#
#   - Blimp's Int is 64-bit and does not wrap; Temper's Int is 32-bit wrapping.
#   - Blimp's to_string drops a whole Float's decimal point: 1.0 prints as "1".
#   - Blimp strings are byte arrays over UTF-8; Temper strings are addressed by
#     code point.
#
# Everything here is plain Blimp so it can be read, tested and stepped through
# with the same tools as translated code.

# ── Int ──────────────────────────────────────────────

# Wrap to a signed 32-bit value, the way Temper's Int arithmetic does.
def temper_int32(n: Int) -> Int do
  m = rem(n, 4294967296)
  m2 = case m < 0 do
    true -> m + 4294967296
    _ -> m
  end
  case m2 >= 2147483648 do
    true -> m2 - 4294967296
    _ -> m2
  end
end

# ── Float ────────────────────────────────────────────

# Temper prints a whole float with its decimal point; Blimp does not.
def temper_float_to_string(f: Float) -> String do
  s = to_string(f)
  case s == "nan" do
    true -> "NaN"
    _ -> case s == "inf" do
      true -> "Infinity"
      _ -> case s == "-inf" do
        true -> "-Infinity"
        _ -> case slice(s, 0, 1) == "-" do
          true -> concat("-", temper_float_body(slice(s, 1, length(s) - 1)))
          _ -> temper_float_body(s)
        end
      end
    end
  end
end

# Temper writes a float the way JavaScript does: plainly until the exponent
# reaches 21 or falls to -7, and in exponent form past that, with a mantissa
# that always has a decimal point. Blimp's to_string expands instead --
# 1e25 comes out as twenty-six digits and 1e207 as two hundred and eight -- so
# the exponent has to be counted back out of the digits.
def temper_float_body(s: String) -> String do
  dot = temper_index_of_from(s, ".", 0)
  whole = case dot < 0 do
    true -> s
    _ -> slice(s, 0, dot)
  end
  frac = case dot < 0 do
    true -> ""
    _ -> slice(s, dot + 1, length(s) - dot - 1)
  end
  case whole == "0" do
    true -> temper_float_small(frac, s)
    _ -> temper_float_large(whole, frac, s)
  end
end

def temper_float_large(whole: String, frac: String, s: String) -> String do
  exponent = length(whole) - 1
  case exponent >= 21 do
    true -> temper_float_exp(concat(whole, frac), exponent)
    _ -> case empty?(frac) do
      true -> concat(s, ".0")
      _ -> s
    end
  end
end

def temper_float_small(frac: String, s: String) -> String do
  z = temper_leading_zeros(frac, 0)
  case z >= length(frac) do
    true -> "0.0"
    _ -> case z >= 6 do
      true -> temper_float_exp(slice(frac, z, length(frac) - z), 0 - z - 1)
      _ -> s
    end
  end
end

def temper_float_exp(digits: String, exponent: Int) -> String do
  sign = case exponent < 0 do
    true -> "-"
    _ -> "+"
  end
  mag = case exponent < 0 do
    true -> 0 - exponent
    _ -> exponent
  end
  concat(temper_float_mantissa(digits), concat("e", concat(sign, to_string(mag))))
end

# The point goes after the first digit, trailing zeros go, and one digit stays
# behind it: Temper writes 1e25 as 1.0e+25, not 1e+25.
def temper_float_mantissa(digits: String) -> String do
  rest = temper_strip_trailing_zeros(slice(digits, 1, length(digits) - 1))
  case empty?(rest) do
    true -> concat(slice(digits, 0, 1), ".0")
    _ -> concat(slice(digits, 0, 1), concat(".", rest))
  end
end

def temper_strip_trailing_zeros(s: String) -> String do
  case length(s) <= 1 do
    true -> s
    _ -> case slice(s, length(s) - 1, 1) == "0" do
      true -> temper_strip_trailing_zeros(slice(s, 0, length(s) - 1))
      _ -> s
    end
  end
end

def temper_leading_zeros(s: String, i: Int) -> Int do
  case i >= length(s) or slice(s, i, 1) != "0" do
    true -> i
    _ -> temper_leading_zeros(s, i + 1)
  end
end

# Blimp has no way to write an infinity, and refuses to divide by zero, so the
# two values IEEE arithmetic produces at the edges are built by overflowing.
def temper_float_inf() -> Float do
  1e308 * 1e10
end

def temper_float_nan() -> Float do
  temper_float_inf() - temper_float_inf()
end

# `f < 0.0` is false for a negative zero, and the sign of a zero decides the
# sign of the infinity it divides into. The printed form still carries it.
def temper_float_is_negative(f: Float) -> Bool do
  case f < 0.0 do
    true -> true
    _ -> slice(to_string(f), 0, 1) == "-"
  end
end

# Temper's Floats are totally ordered, and IEEE's are not: a negative zero sits
# below a positive one, a NaN equals itself, and a NaN is above everything.
# All three are false with Blimp's operators, so every Float comparison goes
# through these. `min` and `max` are not comparisons -- they answer NaN either
# way, which is what types/float/ops asks for.
def temper_float_eq(a: Float, b: Float) -> Bool do
  case a != a do
    true -> b != b
    _ -> case b != b do
      true -> false
      _ -> case a == b do
        true -> temper_float_is_negative(a) == temper_float_is_negative(b)
        _ -> false
      end
    end
  end
end

def temper_float_ne(a: Float, b: Float) -> Bool do
  not(temper_float_eq(a, b))
end

def temper_float_lt(a: Float, b: Float) -> Bool do
  case a != a do
    true -> false
    _ -> case b != b do
      true -> true
      _ -> case a == b do
        true -> temper_float_is_negative(a) and not(temper_float_is_negative(b))
        _ -> a < b
      end
    end
  end
end

def temper_float_gt(a: Float, b: Float) -> Bool do
  temper_float_lt(b, a)
end

def temper_float_le(a: Float, b: Float) -> Bool do
  temper_float_lt(a, b) or temper_float_eq(a, b)
end

def temper_float_ge(a: Float, b: Float) -> Bool do
  temper_float_le(b, a)
end

# An Int is a Float the moment it is added to one.
def temper_int_to_float(n: Int) -> Float do
  n + 0.0
end

# The checked form refuses an Int64 a Float64 cannot hold exactly, which is
# anything past 2^53-1. The unchecked one above does not ask.
def temper_int_to_float_checked(n: Int) -> Float do
  case n > 9007199254740991 or n < 0 - 9007199254740991 do
    true -> temper_bubble()
    _ -> n + 0.0
  end
end

# ── Parsing floats ───────────────────────────────────
#
# Blimp has to_int and no to_float, so this is the whole grammar: an optional
# sign, digits with at most one point, an optional exponent. Anything else
# bubbles, which is what `"totally".toFloat64()` has to do.

def temper_parse_float(s: String) -> Float do
  t = temper_trim(s)
  case t == "NaN" do
    true -> temper_float_nan()
    _ -> case t == "Infinity" do
      true -> temper_float_inf()
      _ -> case t == "-Infinity" do
        true -> 0.0 - temper_float_inf()
        _ -> case empty?(t) do
          true -> temper_bubble()
          _ -> temper_parse_float_sign(t)
        end
      end
    end
  end
end

def temper_parse_float_sign(t: String) -> Float do
  case slice(t, 0, 1) == "-" do
    # Not `0.0 - x`: that answers 0.0 for a zero, and "-0" has to parse to the
    # negative one Temper orders below it.
    true -> temper_parse_float_unsigned(slice(t, 1, length(t) - 1)) * (0.0 - 1.0)
    _ -> case slice(t, 0, 1) == "+" do
      true -> temper_parse_float_unsigned(slice(t, 1, length(t) - 1))
      _ -> temper_parse_float_unsigned(t)
    end
  end
end

def temper_parse_float_unsigned(t: String) -> Float do
  e = temper_find_exp(t, 0)
  case e < 0 do
    true -> temper_parse_decimal(t)
    _ ->
      mantissa = temper_parse_decimal(slice(t, 0, e))
      exponent = temper_parse_exponent(slice(t, e + 1, length(t) - e - 1))
      mantissa * pow(10.0, exponent + 0.0)
  end
end

def temper_find_exp(t: String, i: Int) -> Int do
  case i >= length(t) do
    true -> 0 - 1
    _ -> case slice(t, i, 1) == "e" or slice(t, i, 1) == "E" do
      true -> i
      _ -> temper_find_exp(t, i + 1)
    end
  end
end

def temper_parse_decimal(t: String) -> Float do
  dot = temper_index_of_from(t, ".", 0)
  case dot < 0 do
    true -> temper_digits_value(t) + 0.0
    _ -> temper_parse_frac(slice(t, 0, dot), slice(t, dot + 1, length(t) - dot - 1))
  end
end

# Digits are required on both sides of the point: Temper reads neither "2."
# nor ".2".
def temper_parse_frac(whole: String, frac: String) -> Float do
  case empty?(whole) or empty?(frac) do
    true -> temper_bubble()
    _ -> (temper_digits_value(concat(whole, frac)) + 0.0) / pow(10.0, length(frac) + 0.0)
  end
end

# `1.0e+25` is what temper_float_to_string writes, so the parser has to read
# its own output, and temper_parse_int64 takes a minus and not a plus.
def temper_parse_exponent(s: String) -> Int do
  case empty?(s) do
    true -> temper_bubble()
    _ -> case slice(s, 0, 1) == "+" do
      true -> temper_parse_int64(slice(s, 1, length(s) - 1), 10)
      _ -> temper_parse_int64(s, 10)
    end
  end
end

# Digits and nothing else. temper_parse_int64 reads its own sign, so handing it
# the mantissa directly made "--1" parse as 1.0 and a bare "-" as -0.0.
def temper_digits_value(s: String) -> Int do
  case empty?(s) or not(temper_all_digits(s, 0)) do
    true -> temper_bubble()
    _ -> temper_parse_int64(s, 10)
  end
end

def temper_all_digits(s: String, i: Int) -> Bool do
  case i >= length(s) do
    true -> true
    _ -> case char_code(s, i) >= 48 and char_code(s, i) <= 57 do
      true -> temper_all_digits(s, i + 1)
      _ -> false
    end
  end
end

# Temper's `/` on Floats is IEEE: by zero it gives an infinity, and 0.0 / 0.0
# gives a NaN. Blimp's `/` raises on a zero divisor, which is a reasonable
# thing for a language to do and not what Temper means.
def temper_float_div(a: Float, b: Float) -> Float do
  case b == 0.0 do
    true -> case a == 0.0 or a != a do
      true -> temper_float_nan()
      _ -> case temper_float_is_negative(a) != temper_float_is_negative(b) do
        true -> 0.0 - temper_float_inf()
        _ -> temper_float_inf()
      end
    end
    _ -> a / b
  end
end

# ── UTF-8 ────────────────────────────────────────────

# Byte count of the sequence that starts with byte b.
def u8_seq_len(b: Int) -> Int do
  case b < 128 do
    true -> 1
    _ -> case b < 224 do
      true -> 2
      _ -> case b < 240 do
        true -> 3
        _ -> 4
      end
    end
  end
end

# The code point whose sequence starts at byte index i.
def u8_decode_at(s: String, i: Int) -> Int do
  b0 = char_code(s, i)
  n = u8_seq_len(b0)
  case n == 1 do
    true -> b0
    _ -> case n == 2 do
      true -> (rem(b0, 32) * 64) + rem(char_code(s, i + 1), 64)
      _ -> case n == 3 do
        true -> (rem(b0, 16) * 4096) + (rem(char_code(s, i + 1), 64) * 64) + rem(char_code(s, i + 2), 64)
        _ -> (rem(b0, 8) * 262144) + (rem(char_code(s, i + 1), 64) * 4096) + (rem(char_code(s, i + 2), 64) * 64) + rem(char_code(s, i + 3), 64)
      end
    end
  end
end

# Encode one code point as UTF-8 bytes. Temper bubbles rather than encoding
# something that is not a code point: past the last one, or a surrogate half,
# which UTF-8 has no business carrying.
def u8_encode_checked(cp: Int) -> String do
  case cp < 0 or cp > 1114111 or (cp >= 55296 and cp <= 57343) do
    true -> temper_bubble()
    _ -> u8_encode(cp)
  end
end

def u8_encode(cp: Int) -> String do
  case cp < 128 do
    true -> from_char_code(cp)
    _ -> case cp < 2048 do
      true -> concat(from_char_code(192 + (cp / 64)), from_char_code(128 + rem(cp, 64)))
      _ -> case cp < 65536 do
        true -> concat(from_char_code(224 + (cp / 4096)),
                  concat(from_char_code(128 + rem(cp / 64, 64)), from_char_code(128 + rem(cp, 64))))
        _ -> concat(from_char_code(240 + (cp / 262144)),
               concat(from_char_code(128 + rem(cp / 4096, 64)),
                 concat(from_char_code(128 + rem(cp / 64, 64)), from_char_code(128 + rem(cp, 64)))))
      end
    end
  end
end

# Every code point in s, in order.
def u8_code_points(s: String) -> List do
  u8_cp_loop(s, 0, [])
end

def u8_cp_loop(s: String, i: Int, acc: List) -> List do
  case i >= length(s) do
    true -> acc
    _ ->
      cp = u8_decode_at(s, i)
      u8_cp_loop(s, i + u8_seq_len(char_code(s, i)), append(acc, cp))
  end
end

# String.fromCodePoints: every code point encoded and run together.
def temper_string_from_code_points(codes: Any) -> String do
  temper_from_cp_loop(temper_items(codes), "")
end

def temper_from_cp_loop(codes: List, acc: String) -> String do
  case empty?(codes) do
    true -> acc
    _ -> temper_from_cp_loop(tail(codes), concat(acc, u8_encode_checked(head(codes))))
  end
end

# Temper's String.length counts code points, not bytes.
def temper_string_length(s: String) -> Int do
  length(u8_code_points(s))
end

# Temper's String indices are byte offsets that must land on a sequence start,
# so advancing is a byte step of the current sequence's width.
#
# The end is as far as it goes: `char_code` past the end answers nil, and
# u8_seq_len takes an Int, so walking off the end used to stop the program
# rather than stop at the end. `"foo-bar".step(i, 100)` is the case that
# found it.
def temper_string_next(s: String, i: Int) -> Int do
  case i >= length(s) do
    true -> length(s)
    _ -> i + u8_seq_len(char_code(s, i))
  end
end

def temper_string_code_point_at(s: String, i: Int) -> Int do
  u8_decode_at(s, i)
end

# ── Float to Int ─────────────────────────────────────
#
# Temper truncates toward zero. Blimp's floor and ceil both answer Ints, and
# which one truncates depends on the sign.

def temper_float_trunc(f: Float) -> Int do
  case f < 0.0 do
    true -> ceil(f)
    _ -> floor(f)
  end
end

# Checked: a NaN or anything outside Int32 bubbles.
def temper_float_to_int32(f: Float) -> Int do
  case f != f or f <= 0.0 - 2147483649.0 or f >= 2147483648.0 do
    true -> temper_bubble()
    _ -> temper_float_trunc(f)
  end
end

# Unchecked: saturates at the ends, and a NaN is zero.
def temper_float_to_int32_unsafe(f: Float) -> Int do
  case f != f do
    true -> 0
    _ -> case f >= 2147483648.0 do
      true -> 2147483647
      _ -> case f <= 0.0 - 2147483649.0 do
        true -> 0 - 2147483648
        _ -> temper_float_trunc(f)
      end
    end
  end
end

def temper_float_to_int64(f: Float) -> Int do
  case f != f or f < 0.0 - 9007199254740991.0 or f > 9007199254740991.0 do
    true -> temper_bubble()
    _ -> temper_float_trunc(f)
  end
end

# The checked form above stops at 2^53-1, where a Float stops counting integers
# exactly. The unchecked one saturates at Int64's own ends instead: it is not
# claiming the answer is exact, only that it is in range.
def temper_float_to_int64_unsafe(f: Float) -> Int do
  case f != f do
    true -> 0
    _ -> case f >= 9223372036854775808.0 do
      true -> 9223372036854775807
      _ -> case f < 0.0 - 9223372036854775808.0 do
        true -> temper_int64_min()
        _ -> temper_float_trunc(f)
      end
    end
  end
end

# ── Int to String with a radix ───────────────────────
#
# Blimp's to_string takes no radix, and `cp.toString(16)` is how the string
# tests print a code point.

# The digits come off the negative side, because `0 - n` for the most negative
# Int is itself: negating first turned `(-2^63).toString(16)` into digits of a
# number that was still negative.
def temper_int_to_string_radix(n: Int, radix: Int) -> String do
  case n == 0 do
    true -> "0"
    _ -> case n < 0 do
      true -> concat("-", temper_radix_digits_neg(n, radix, ""))
      _ -> temper_radix_digits(n, radix, "")
    end
  end
end

def temper_radix_digits_neg(n: Int, radix: Int, acc: String) -> String do
  case n == 0 do
    true -> acc
    _ -> temper_radix_digits_neg(n / radix, radix, concat(temper_radix_digit(0 - rem(n, radix)), acc))
  end
end

def temper_radix_digits(n: Int, radix: Int, acc: String) -> String do
  case n == 0 do
    true -> acc
    _ -> temper_radix_digits(n / radix, radix, concat(temper_radix_digit(rem(n, radix)), acc))
  end
end

def temper_radix_digit(d: Int) -> String do
  case d < 10 do
    true -> from_char_code(48 + d)
    _ -> from_char_code(87 + d)
  end
end

# ── Checked division ─────────────────────────────────

# Temper's `/` and `%` on Int bubble on a zero divisor rather than trapping.
def temper_int_div(a: Int, b: Int) -> Int do
  case b == 0 do
    true -> bubble :divide_by_zero
    _ -> temper_int32(a / b)
  end
end

# ── Parsing integers with a radix ────────────────────
#
# Blimp's `to_int` reads decimal only and takes no radix, so `"7FFFFFFF"
# .toInt32(16)` needs this. The accumulator runs *negative*: the negative range
# is one wider than the positive one, so a positive accumulator could not hold
# Int64's minimum, and `"-8000000000000000"` has to parse.

def temper_int64_min() -> Int do
  0 - 9223372036854775807 - 1
end

def temper_digit_value(c: Int) -> Int do
  case c >= 48 and c <= 57 do
    true -> c - 48
    _ -> temper_digit_alpha(c)
  end
end

def temper_digit_alpha(c: Int) -> Int do
  case c >= 65 and c <= 90 do
    true -> c - 55
    _ -> temper_digit_lower(c)
  end
end

def temper_digit_lower(c: Int) -> Int do
  case c >= 97 and c <= 122 do
    true -> c - 87
    _ -> 0 - 1
  end
end

# The radix is optional in Temper and nil when left out, and the text may be
# padded: `" 2 ".toInt32()` is 2.
def temper_parse_int64(s: String, radix: Any) -> Int do
  t = temper_trim(s)
  r = case nil?(radix) do
    true -> 10
    _ -> radix
  end
  n = length(t)
  # Base 36 is as far as the digits go: `"20".toInt32(37)` is an error, not 74.
  case n == 0 or r < 2 or r > 36 do
    true -> temper_bubble()
    _ -> temper_parse_signed(t, r, n)
  end
end

def temper_trim(s: String) -> String do
  temper_trim_end(temper_trim_start(s))
end

def temper_trim_start(s: String) -> String do
  case empty?(s) or not(temper_is_space(char_code(s, 0))) do
    true -> s
    _ -> temper_trim_start(slice(s, 1, length(s) - 1))
  end
end

def temper_trim_end(s: String) -> String do
  case empty?(s) or not(temper_is_space(char_code(s, length(s) - 1))) do
    true -> s
    _ -> temper_trim_end(slice(s, 0, length(s) - 1))
  end
end

def temper_is_space(c: Int) -> Bool do
  c == 32 or c == 9 or c == 10 or c == 13
end

def temper_parse_signed(s: String, radix: Int, n: Int) -> Int do
  case char_code(s, 0) == 45 do
    true -> temper_parse_from(s, radix, 1, n, true)
    _ -> temper_parse_from(s, radix, 0, n, false)
  end
end

def temper_parse_from(s: String, radix: Int, start: Int, n: Int, neg: Bool) -> Int do
  case start >= n do
    # A sign with no digits after it is not a number.
    true -> temper_bubble()
    _ -> temper_parse_end(temper_parse_digits(s, radix, start, n, 0), neg)
  end
end

def temper_parse_digits(s: String, radix: Int, i: Int, n: Int, acc: Int) -> Int do
  case i >= n do
    true -> acc
    _ -> temper_parse_digits(s, radix, i + 1, n, temper_parse_step(acc, radix, temper_digit_value(char_code(s, i))))
  end
end

def temper_parse_step(acc: Int, radix: Int, d: Int) -> Int do
  case d < 0 or d >= radix do
    true -> temper_bubble()
    _ -> temper_parse_scale(acc, radix, d)
  end
end

# Checked before multiplying, because the multiply itself now wraps silently.
def temper_parse_scale(acc: Int, radix: Int, d: Int) -> Int do
  case acc < temper_int64_min() / radix do
    true -> temper_bubble()
    _ -> temper_parse_subtract(acc * radix, d)
  end
end

def temper_parse_subtract(scaled: Int, d: Int) -> Int do
  case scaled < temper_int64_min() + d do
    true -> temper_bubble()
    _ -> scaled - d
  end
end

def temper_parse_end(acc: Int, neg: Bool) -> Int do
  case neg do
    true -> acc
    _ -> temper_parse_positive(acc)
  end
end

def temper_parse_positive(acc: Int) -> Int do
  case acc == temper_int64_min() do
    # The one magnitude that has no positive counterpart.
    true -> temper_bubble()
    _ -> 0 - acc
  end
end

def temper_parse_int32(s: String, radix: Any) -> Int do
  temper_fit_int32(temper_parse_int64(s, radix))
end

def temper_fit_int32(v: Int) -> Int do
  case v < 0 - 2147483648 or v > 2147483647 do
    true -> temper_bubble()
    _ -> v
  end
end

def temper_int_rem(a: Int, b: Int) -> Int do
  case b == 0 do
    true -> bubble :divide_by_zero
    _ -> rem(a, b)
  end
end

# ── Failure ──────────────────────────────────────────

# `bubble` only parses inside an actor handler or a case arm, never at the top
# of a `def` body, so these wrap it in a one-armed case to make it callable
# from anywhere. Both are catchable with try/catch.

def temper_bubble() -> Any do
  case true do
    true -> bubble :temper_bubble
  end
end

# Code the frontend refused, translated anyway.
#
# semantics/broken pushes deliberately bad Temper through every backend to
# check it degrades rather than crashing, so a `TODO()` in the translator is
# the wrong answer: it takes the compiler down and reports nothing.
#
# The reason is what the bubble carries: `bubble` takes any value, and the
# earlier parse error that suggested otherwise was `bubble` needing to be an
# arm's body rather than a bare statement in a `def`.
def temper_untranslatable(why: String) -> Any do
  case true do
    true -> bubble why
  end
end

def temper_panic() -> Any do
  case true do
    true -> bubble :temper_panic
  end
end

# ── Bit operations ───────────────────────────────────
#
# Blimp has no bitwise operators, so these do it arithmetically over the
# unsigned 32-bit view and wrap the result back to signed.

# Unsigned 32-bit view, so the bit loops only ever see non-negative numbers.
def temper_u32(n: Int) -> Int do
  m = rem(n, 4294967296)
  case m < 0 do
    true -> m + 4294967296
    _ -> m
  end
end

# One loop drives all three of and/or/xor; `which` picks the rule.
def temper_bitop(which: Atom, a: Int, b: Int) -> Int do
  temper_int32(temper_bitop_loop(which, temper_u32(a), temper_u32(b), 0, 1))
end

def temper_bit_rule(which: Atom, x: Int, y: Int) -> Int do
  case which do
    :and -> x * y
    :or -> case x + y > 0 do
      true -> 1
      _ -> 0
    end
    _ -> rem(x + y, 2)
  end
end

def temper_bitop_loop(which: Atom, a: Int, b: Int, acc: Int, place: Int) -> Int do
  case a == 0 and b == 0 do
    true -> acc
    _ -> temper_bitop_loop(
      which,
      a / 2,
      b / 2,
      acc + (temper_bit_rule(which, rem(a, 2), rem(b, 2)) * place),
      place * 2
    )
  end
end

def temper_bit_and(a: Int, b: Int) -> Int do temper_bitop(:and, a, b) end
def temper_bit_or(a: Int, b: Int) -> Int do temper_bitop(:or, a, b) end
def temper_bit_xor(a: Int, b: Int) -> Int do temper_bitop(:xor, a, b) end
def temper_bit_not(a: Int) -> Int do temper_int32(0 - a - 1) end

# ── Int64 bit operations ─────────────────────────────
#
# The 32-bit helpers above work on the unsigned image of a value, which needs
# 2^32 and fits. 2^64 does not, so these split the sign bit off and put it
# back: `temper_low63` is the value with that bit cleared, which for a negative
# number is what subtracting the minimum computes.

def temper_low63(n: Int) -> Int do
  case n < 0 do
    true -> n - temper_int64_min()
    _ -> n
  end
end

def temper_sign_bit(n: Int) -> Int do
  case n < 0 do
    true -> 1
    _ -> 0
  end
end

def temper_bitop64(which: Atom, a: Int, b: Int) -> Int do
  low = temper_bitop_loop(which, temper_low63(a), temper_low63(b), 0, 1)
  case temper_bit_rule(which, temper_sign_bit(a), temper_sign_bit(b)) == 1 do
    true -> low + temper_int64_min()
    _ -> low
  end
end

def temper_bit_and64(a: Int, b: Int) -> Int do temper_bitop64(:and, a, b) end
def temper_bit_or64(a: Int, b: Int) -> Int do temper_bitop64(:or, a, b) end
def temper_bit_xor64(a: Int, b: Int) -> Int do temper_bitop64(:xor, a, b) end
def temper_bit_not64(a: Int) -> Int do 0 - a - 1 end

# The multiply wraps, which is what a left shift past the top bit means.
def temper_shl64(a: Int, n: Int) -> Int do
  a * temper_pow2(temper_shift_count(n, 64))
end

def temper_shr64(a: Int, n: Int) -> Int do
  d = temper_pow2(temper_shift_count(n, 64))
  q = a / d
  case a < 0 and rem(a, d) != 0 do
    true -> q - 1
    _ -> q
  end
end

# Logical: shift a negative right by one arithmetically, clear the sign bit the
# copy left behind, then shift the rest of the way on a non-negative number.
def temper_ushr64(a: Int, n: Int) -> Int do
  k = temper_shift_count(n, 64)
  case k == 0 or a >= 0 do
    true -> temper_shr64(a, k)
    _ -> temper_low63(temper_shr64(a, 1)) / temper_pow2(k - 1)
  end
end

def temper_pow2(n: Int) -> Int do
  case n <= 0 do
    true -> 1
    _ -> 2 * temper_pow2(n - 1)
  end
end

# A shift count is its low bits, so `x << -1` is `x << 31` at 32 bits and
# `x << 63` at 64. Blimp's rem keeps the sign, so -1 stays -1 and 2^-1 is 1:
# the shift quietly did nothing.
def temper_shift_count(n: Int, width: Int) -> Int do
  k = rem(n, width)
  case k < 0 do
    true -> k + width
    _ -> k
  end
end

def temper_shl32(a: Int, n: Int) -> Int do
  temper_int32(a * temper_pow2(temper_shift_count(n, 32)))
end

# Arithmetic shift right: Blimp's `/` truncates toward zero, so a negative
# value needs the floor, which is what a shift means.
def temper_shr32(a: Int, n: Int) -> Int do
  d = temper_pow2(temper_shift_count(n, 32))
  q = a / d
  case a < 0 and rem(a, d) != 0 do
    true -> q - 1
    _ -> q
  end
end

def temper_ushr32(a: Int, n: Int) -> Int do
  temper_int32(temper_u32(a) / temper_pow2(temper_shift_count(n, 32)))
end

# ── Runtime type tests ───────────────────────────────

def temper_list_has(items: List, target: Any) -> Bool do
  case empty?(items) do
    true -> false
    _ -> case head(items) == target do
      true -> true
      _ -> temper_list_has(tail(items), target)
    end
  end
end

# Temper's `instanceof`. A primitive answers from type_of; an actor answers
# from the :__temper_types list every translated class carries, which names the
# class and its supertypes so a subtype test works.
def temper_is_a(value: Any, tag: Atom) -> Bool do
  case tag do
    # StringIndexOption is an Int here, split by sign, so these two tags are
    # predicates rather than type names. Temper asks both ways: `i is
    # StringIndex` and `i as NoStringIndex`.
    :StringIndex -> temper_is_string_index(value)
    :NoStringIndex -> temper_is_no_string_index(value)
    _ -> temper_has_type(value, tag)
  end
end

def temper_is_string_index(value: Any) -> Bool do
  case type_of(value) == :integer do
    true -> value >= 0
    _ -> false
  end
end

def temper_is_no_string_index(value: Any) -> Bool do
  case type_of(value) == :integer do
    true -> value < 0
    _ -> false
  end
end

def temper_has_type(value: Any, tag: Atom) -> Bool do
  t = type_of(value)
  case t == :actor_ref do
    true -> temper_list_has(value <- :__temper_types, tag)
    _ -> t == tag
  end
end

# ── Core API shims ───────────────────────────────────

# Blimp's slice takes a LENGTH, not an end index: slice("hello", 0, 4) is
# "hell". Temper's second argument is an exclusive end.
def temper_slice(s: Any, start: Int, stop: Int) -> Any do
  case stop <= start do
    true -> ""
    _ -> slice(s, start, stop - start)
  end
end

# Temper's String indices are byte offsets, and `end` is one past the last.
def temper_string_end(s: String) -> Int do
  length(s)
end

def temper_string_has_index(s: String, i: Int) -> Bool do
  i >= 0 and i < length(s)
end

# Some Temper conversions are no-ops in Blimp.
def temper_identity(x: Any) -> Any do
  x
end

# Temper's split, which Blimp's `split` is not: Blimp runs consecutive
# separators together and counts bytes, while Temper keeps every empty piece
# and an empty separator cuts between code points.
#
#     " g  h i".split(" ")   ["", "g", "", "h", "i"]
#     "def".split("")        ["d", "e", "f"]
#     "".split("")           []
#     "\u{1F30D}".split("")         ["\u{1F30D}"]     -- four bytes, one piece
def temper_string_split(s: String, sep: String) -> List do
  case sep == "" do
    true -> temper_string_code_points(s)
    _ -> temper_string_split_loop(s, sep, [])
  end
end

def temper_string_split_loop(s: String, sep: String, acc: List) -> List do
  i = temper_index_of_from(s, sep, 0)
  case i < 0 do
    true -> acc ++ [s]
    _ -> temper_string_split_loop(
      slice(s, i + length(sep), length(s) - i - length(sep)),
      sep,
      acc ++ [slice(s, 0, i)]
    )
  end
end

# `indexOf` answers a byte offset, or -1 when the needle is not there. A nil
# start means from the beginning.
def temper_string_index_of(s: String, needle: String, start: Any) -> Int do
  from = case nil?(start) do
    true -> 0
    _ -> start
  end
  temper_index_of_from(s, needle, from)
end

def temper_index_of_from(s: String, sub: String, i: Int) -> Int do
  case i + length(sub) > length(s) do
    true -> 0 - 1
    _ -> case slice(s, i, length(sub)) == sub do
      true -> i
      _ -> temper_index_of_from(s, sub, i + 1)
    end
  end
end

def temper_string_code_points(s: String) -> List do
  temper_code_points_loop(s, 0, [])
end

def temper_code_points_loop(s: String, i: Int, acc: List) -> List do
  case i >= length(s) do
    true -> acc
    _ ->
      n = u8_seq_len(char_code(s, i))
      temper_code_points_loop(s, i + n, acc ++ [slice(s, i, n)])
  end
end

# ── List operations ──────────────────────────────────
#
# Blimp has map, reduce and sort but no filter or join, and its `reduce` takes
# the initial value, so reduceFrom lines up with it directly.

def temper_filter(items: Any, keep: Any) -> List do
  temper_filter_loop(temper_items(items), keep, [])
end

def temper_filter_loop(items: List, keep: Any, acc: List) -> List do
  case empty?(items) do
    true -> acc
    _ ->
      x = head(items)
      acc2 = case keep(x) do
        true -> append(acc, x)
        _ -> acc
      end
      temper_filter_loop(tail(items), keep, acc2)
  end
end

def temper_join(source: Any, sep: String, show: Any) -> String do
  items = temper_items(source)
  case empty?(items) do
    true -> ""
    _ -> temper_join_loop(tail(items), sep, show, show(head(items)))
  end
end

def temper_join_loop(items: List, sep: String, show: Any, acc: String) -> String do
  case empty?(items) do
    true -> acc
    _ -> temper_join_loop(tail(items), sep, show, concat(acc, concat(sep, show(head(items)))))
  end
end

def temper_for_each(source: Any, body: Any) -> Any do
  items = temper_items(source)
  case empty?(items) do
    true -> nil
    _ ->
      body(head(items))
      temper_for_each(tail(items), body)
  end
end

# ── Comparison and float maths ───────────────────────

# Blimp cannot compare strings with < or >, so strings go byte by byte.
def temper_str_cmp(a: String, b: String) -> Int do
  temper_str_cmp_loop(a, b, 0)
end

def temper_str_cmp_loop(a: String, b: String, i: Int) -> Int do
  case i >= length(a) do
    true -> case i >= length(b) do
      true -> 0
      _ -> 0 - 1
    end
    _ -> case i >= length(b) do
      true -> 1
      _ ->
        x = char_code(a, i)
        y = char_code(b, i)
        case x == y do
          true -> temper_str_cmp_loop(a, b, i + 1)
          _ -> case x < y do
            true -> 0 - 1
            _ -> 1
          end
        end
    end
  end
end

# Temper's `<=>` is -1, 0 or 1.
def temper_cmp(a: Any, b: Any) -> Int do
  case type_of(a) == :string do
    true -> temper_str_cmp(a, b)
    _ -> case a < b do
      true -> 0 - 1
      _ -> case a > b do
        true -> 1
        _ -> 0
      end
    end
  end
end

def temper_str_lt(a: String, b: String) -> Bool do temper_str_cmp(a, b) < 0 end
def temper_str_le(a: String, b: String) -> Bool do temper_str_cmp(a, b) <= 0 end
def temper_str_gt(a: String, b: String) -> Bool do temper_str_cmp(a, b) > 0 end
def temper_str_ge(a: String, b: String) -> Bool do temper_str_cmp(a, b) >= 0 end

# Float remainder, truncated toward zero like Temper's.
def temper_fmod(a: Float, b: Float) -> Float do
  q = a / b
  t = case q < 0.0 do
    true -> 0.0 - floor(0.0 - q)
    _ -> floor(q)
  end
  a - (b * t)
end

# Temper's Float64.near, which is Python's math.isclose: within a relative
# tolerance of the larger magnitude, or within an absolute one. A nil argument
# is one the caller left out, so the defaults live here.
def temper_float_near(x: Float, y: Float, rel_tol: Any, abs_tol: Any) -> Bool do
  r = case nil?(rel_tol) do
    true -> 1e-9
    _ -> rel_tol
  end
  a = case nil?(abs_tol) do
    true -> 0.0
    _ -> abs_tol
  end
  margin = temper_float_max(temper_float_max(abs(x), abs(y)) * r, a)
  abs(x - y) <= margin
end

# Temper's ceil, floor and round answer a Float; Blimp's answer an Int, and
# adding 0.0 is how an Int becomes one.
def temper_float_ceil(f: Float) -> Float do
  ceil(f) + 0.0
end

def temper_float_floor(f: Float) -> Float do
  floor(f) + 0.0
end

def temper_float_round(f: Float) -> Float do
  round(f) + 0.0
end

# Blimp's min and max are Int-only, and its checker says so before the program
# runs.
# A NaN in either position wins, which is what Temper says and what a plain
# comparison does not do: every comparison with a NaN is false.
def temper_float_min(a: Float, b: Float) -> Float do
  case a != a or b != b do
    true -> temper_float_nan()
    _ -> case a < b do
      true -> a
      _ -> b
    end
  end
end

def temper_float_max(a: Float, b: Float) -> Float do
  case a != a or b != b do
    true -> temper_float_nan()
    _ -> case a > b do
      true -> a
      _ -> b
    end
  end
end

# -1.0, 1.0, or the zero itself: Temper keeps the sign of a signed zero, so
# `(-0.0).sign()` is -0.0 and not 0.0.
def temper_float_sign(f: Float) -> Float do
  case f > 0.0 do
    true -> 1.0
    _ -> case f < 0.0 do
      true -> 0.0 - 1.0
      _ -> f
    end
  end
end

# `**`. Blimp's pow takes a fractional exponent, so this is a rename; it used
# to be exponentiation by squaring and bubbled on anything but a whole number,
# which made `4.0 ** -0.5` an error rather than 0.5.
def temper_pow(base: Float, exponent: Float) -> Float do
  pow(base, exponent)
end

# ── Tests ────────────────────────────────────────────
#
# Blimp has no test framework to ask for a report, so a translated test module
# runs its own tests and writes the JUnit XML the harness reads. Each test is
# a `def` taking the Test it reports to; an assertion that fails records the
# message its closure returns, and one that passes never calls the closure.

actor TemperTest do
  state failures: List :: []

  on :assert(ok: Bool, msg: Any) do
    next = case ok do
      true -> failures
      _ -> append(failures, msg())
    end
    become failures: next
    reply nil
  end

  on :failures do
    reply failures
  end
end

def temper_run_tests(tests: List, path: String) -> Any do
  results = temper_run_tests_loop(tests, [])
  # A report nobody can read is a failed run: the harness reads this file, and
  # `write_file` answers false rather than raising, so ignoring the answer
  # would turn "could not write" into "all tests passed".
  wrote = write_file(path, temper_junit_xml(results))
  case wrote do
    true -> nil
    _ -> puts(concat("could not write ", path))
  end
  already = case wrote do
    true -> 0
    _ -> 1
  end
  temper_report_tests(results, already)
end

def temper_run_tests_loop(tests: List, acc: List) -> List do
  case empty?(tests) do
    true -> acc
    _ ->
      entry = head(tests)
      temper_run_tests_loop(tail(tests), append(acc, [elem(entry, 0), temper_run_one(elem(entry, 1))]))
  end
end

# A test that bubbles has failed, and what it managed to assert before that
# still counts: the messages come back either way.
def temper_run_one(body: Any) -> List do
  t = spawn TemperTest
  try do
    body(t)
    t <- :failures
  catch do
    append(t <- :failures, "test raised")
  end
end

# A run that reported a failure exits non-zero, because a test runner that
# says nothing to the shell is a test runner nobody notices.
def temper_report_tests(results: List, failed: Int) -> Any do
  case empty?(results) do
    true -> case failed > 0 do
      true -> exit(1)
      _ -> nil
    end
    _ ->
      entry = head(results)
      failures = elem(entry, 1)
      mark = case empty?(failures) do
        true -> "ok   "
        _ -> "FAIL "
      end
      puts(concat(mark, elem(entry, 0)))
      temper_report_tests(tail(results), failed + length(failures))
  end
end

def temper_junit_xml(results: List) -> String do
  concat(
    concat("<testsuites>\n<testsuite name=\"blimp\" tests=\"", to_string(length(results))),
    concat(
      concat("\" failures=\"", to_string(temper_count_failed(results, 0))),
      concat("\" time=\"0\">\n", concat(temper_junit_cases(results, ""), "</testsuite>\n</testsuites>\n"))
    )
  )
end

def temper_count_failed(results: List, n: Int) -> Int do
  case empty?(results) do
    true -> n
    _ ->
      next = case empty?(elem(head(results), 1)) do
        true -> n
        _ -> n + 1
      end
      temper_count_failed(tail(results), next)
  end
end

def temper_junit_cases(results: List, acc: String) -> String do
  case empty?(results) do
    true -> acc
    _ -> temper_junit_cases(tail(results), concat(acc, temper_junit_case(head(results))))
  end
end

def temper_junit_case(entry: List) -> String do
  name = temper_xml_escape(elem(entry, 0))
  failures = elem(entry, 1)
  open = concat(concat("<testcase name=\"", name), "\" time=\"0\" classname=\"blimp\">")
  case empty?(failures) do
    true -> concat(open, "</testcase>\n")
    _ ->
      why = temper_xml_escape(temper_join_failures(failures, ""))
      concat(open, concat(concat("<failure message=\"", why), concat("\">", concat(why, "</failure></testcase>\n"))))
  end
end

def temper_join_failures(failures: List, acc: String) -> String do
  case empty?(failures) do
    true -> acc
    _ ->
      next = case empty?(acc) do
        true -> head(failures)
        _ -> concat(acc, concat(", ", head(failures)))
      end
      temper_join_failures(tail(failures), next)
  end
end

# The message is a Temper string and lands in both an attribute and the
# element body, so the five that matter all go.
def temper_xml_escape(s: String) -> String do
  temper_xml_escape_loop(s, 0, "")
end

def temper_xml_escape_loop(s: String, i: Int, acc: String) -> String do
  case i >= length(s) do
    true -> acc
    _ -> temper_xml_escape_loop(s, i + 1, concat(acc, temper_xml_char(slice(s, i, 1))))
  end
end

def temper_xml_char(c: String) -> String do
  case c == "&" do
    true -> "&amp;"
    _ -> case c == "<" do
      true -> "&lt;"
      _ -> case c == ">" do
        true -> "&gt;"
        _ -> case c == "\"" do
          true -> "&quot;"
          _ -> case c == "'" do
            true -> "&apos;"
            _ -> c
          end
        end
      end
    end
  end
end

# ── Mutable lists ────────────────────────────────────
#
# Temper's ListBuilder is mutable and Blimp's lists are not, so a builder is
# an actor holding a list. Every handler assigns the field name -- which
# shadows the state -- and publishes with one `become`.

actor TemperListBuilder do
  state items: List :: []

  on :__temper_types do reply [:ListBuilder, :Listed] end
  on :items do reply items end
  on :length do reply length(items) end
  on :isEmpty do reply empty?(items) end
  on :get(i: Int) do reply elem(items, i) end

  on :add(x: Any) do
    items = append(items, x)
    become items: items
    reply nil
  end

  on :add_at(x: Any, at: Int) do
    items = temper_list_insert(items, at, x)
    become items: items
    reply nil
  end

  # splice answers the items it removed, and takes nil for either bound: no
  # index means from the start, no count means to the end. The index is
  # clamped, so `splice(length, nil, xs)` appends.
  on :splice_from(index: Any) do
    start = temper_splice_start(index, length(items))
    removed = temper_list_slice(items, start, length(items))
    items = temper_list_slice(items, 0, start)
    become items: items
    reply removed
  end

  on :splice_range(index: Any, removeCount: Any) do
    start = temper_splice_start(index, length(items))
    stop = temper_splice_stop(start, removeCount, length(items))
    removed = temper_list_slice(items, start, stop)
    items = temper_list_slice(items, 0, start) ++ temper_list_slice(items, stop, length(items))
    become items: items
    reply removed
  end

  on :splice(index: Any, removeCount: Any, newValues: Any) do
    start = temper_splice_start(index, length(items))
    stop = temper_splice_stop(start, removeCount, length(items))
    removed = temper_list_slice(items, start, stop)
    before = temper_list_slice(items, 0, start)
    after = temper_list_slice(items, stop, length(items))
    items = (before ++ temper_items(newValues)) ++ after
    become items: items
    reply removed
  end

  on :addAll(xs: Any) do
    items = items ++ temper_items(xs)
    become items: items
    reply nil
  end

  on :addAll_at(xs: Any, at: Int) do
    before = temper_list_slice(items, 0, at)
    after = temper_list_slice(items, at, length(items))
    items = (before ++ temper_items(xs)) ++ after
    become items: items
    reply nil
  end

  on :set(i: Int, v: Any) do
    items = set_at(items, i, v)
    become items: items
    reply nil
  end

  on :reverse do
    items = reverse(items)
    become items: items
    reply nil
  end

  on :clear do
    become items: []
    reply nil
  end

  on :removeLast do
    n = length(items)
    last = elem(items, n - 1)
    items = temper_list_slice(items, 0, n - 1)
    become items: items
    reply last
  end

  on :sort(cmp: Any) do
    items = temper_sort(items, cmp)
    become items: items
    reply nil
  end
end

# A sequence argument may be a plain list or a builder actor; this is what
# lets one set of operations serve both.
def temper_items(x: Any) -> List do
  case nil?(x) do
    true -> []
    _ -> case type_of(x) == :actor_ref do
      true -> x <- :items
      _ -> x
    end
  end
end

# The bounds of a splice, which take nil for "from the start" and "to the end"
# and clamp to what is there. Negative counts remove nothing, as in every other
# backend's temper-core.
def temper_splice_start(index: Any, n: Int) -> Int do
  case nil?(index) or index < 0 do
    true -> 0
    _ -> case index > n do
      true -> n
      _ -> index
    end
  end
end

def temper_splice_stop(start: Int, removeCount: Any, n: Int) -> Int do
  count = case nil?(removeCount) do
    true -> n
    _ -> case removeCount < 0 do
      true -> 0
      _ -> removeCount
    end
  end
  stop = start + count
  case stop > n do
    true -> n
    _ -> stop
  end
end

# `getOr` answers the fallback for an index that is not there, where `get`
# bubbles.
def temper_get_or(source: Any, index: Int, fallback: Any) -> Any do
  items = temper_items(source)
  case index < 0 or index >= length(items) do
    true -> fallback
    _ -> elem(items, index)
  end
end

# ── DenseBitVector ───────────────────────────────────
#
# Dense is a promise about memory, not about behaviour, and Blimp has no packed
# representation to make it with: a list of booleans answers the same
# questions. myers-diff is the program that leans on it.

actor TemperBitVector do
  state bits: List :: []

  on :init(n: Int) do
    bits = temper_falses(n, [])
    become bits: bits
    reply nil
  end

  on :set(i: Int, b: Bool) do
    bits = set_at(bits, i, b)
    become bits: bits
    reply nil
  end

  on :get(i: Int) do
    reply elem(bits, i)
  end
end

def temper_falses(n: Int, acc: List) -> List do
  case n <= 0 do
    true -> acc
    _ -> temper_falses(n - 1, append(acc, false))
  end
end

def temper_new_bit_vector(n: Int) -> Any do
  v = spawn TemperBitVector
  v <- :init(n)
  v
end

# ── Deque ────────────────────────────────────────────
#
# A list held by an actor, like the builders above: adds go on the end and
# removes come off the front, which is what breadth-first work wants.

actor TemperDeque do
  state items: List :: []

  on :add(x: Any) do
    items = append(items, x)
    become items: items
    reply nil
  end

  on :addFirst(x: Any) do
    items = [x] ++ items
    become items: items
    reply nil
  end

  on :removeFirst do
    first = head(items)
    items = tail(items)
    become items: items
    reply first
  end

  on :removeLast do
    last = elem(items, length(items) - 1)
    items = temper_list_slice(items, 0, length(items) - 1)
    become items: items
    reply last
  end

  on :isEmpty do
    reply empty?(items)
  end

  on :length do
    reply length(items)
  end

  on :items do
    reply items
  end
end

def temper_new_deque() -> Any do
  spawn TemperDeque
end

def temper_new_list_builder() -> Any do
  spawn TemperListBuilder
end

# Blimp's slice is strings only, so lists get their own.
# A negative start is clamped, not counted from the end: Temper's slice takes
# an exclusive end and clamps both bounds, so `slice(-2, 0)` is empty rather
# than whatever `elem` makes of a negative index.
def temper_list_slice(items: List, start: Int, stop: Int) -> List do
  from = case start < 0 do
    true -> 0
    _ -> start
  end
  temper_list_slice_loop(items, from, stop, from, [])
end

def temper_list_slice_loop(items: List, start: Int, stop: Int, i: Int, acc: List) -> List do
  case i >= stop or i >= length(items) do
    true -> acc
    _ -> temper_list_slice_loop(items, start, stop, i + 1, append(acc, elem(items, i)))
  end
end

# Blimp's sort takes no comparator, so this is an insertion sort over one.
def temper_sort(items: Any, cmp: Any) -> List do
  temper_sort_loop(temper_items(items), [], cmp)
end

def temper_sort_loop(remaining: List, acc: List, cmp: Any) -> List do
  case empty?(remaining) do
    true -> acc
    _ -> temper_sort_loop(tail(remaining), temper_insert(acc, head(remaining), cmp), cmp)
  end
end

def temper_insert(sorted: List, x: Any, cmp: Any) -> List do
  temper_insert_loop(sorted, x, cmp, [])
end

def temper_insert_loop(rest: List, x: Any, cmp: Any, acc: List) -> List do
  case empty?(rest) do
    true -> append(acc, x)
    _ ->
      h = head(rest)
      # Strictly less than: an item equal to one already placed goes after it,
      # which is what makes the sort stable. With `<= 0` a run of equal items
      # comes out reversed, and sorting by one field of a record showed it.
      case cmp(x, h) < 0 do
        true -> (append(acc, x)) ++ rest
        _ -> temper_insert_loop(tail(rest), x, cmp, append(acc, h))
      end
  end
end

# Sequence operations that accept either a list or a builder.
def temper_len(x: Any) -> Int do length(temper_items(x)) end
def temper_is_empty(x: Any) -> Bool do
  case type_of(x) == :string do
    true -> empty?(x)
    _ -> empty?(temper_items(x))
  end
end
def temper_get(x: Any, i: Int) -> Any do elem(temper_items(x), i) end
def temper_map(x: Any, f: Any) -> List do map(temper_items(x), f) end
def temper_reduce(x: Any, init: Any, f: Any) -> Any do reduce(temper_items(x), init, f) end
def temper_to_list(x: Any) -> List do temper_items(x) end

def temper_new_list_builder_from(items: Any) -> Any do
  b = spawn TemperListBuilder
  b <- :addAll(temper_items(items))
  b
end

# Blimp handlers dispatch on name alone, not arity, so the two shapes of
# Temper's ListBuilder.add reach different messages.
def temper_list_insert(items: List, at: Int, x: Any) -> List do
  (temper_list_slice(items, 0, at) ++ [x]) ++ temper_list_slice(items, at, length(items))
end

# Temper's `as` can fail. Blimp's actors dispatch on whatever they are, so the
# check has to be explicit.
def temper_cast(value: Any, tag: Atom) -> Any do
  case temper_is_a(value, tag) do
    true -> value
    _ -> temper_bubble()
  end
end

# ── Mutable captures ─────────────────────────────────
#
# A Blimp closure captures the values of names already bound when it is made,
# and an assignment inside it is local to it. Temper closures capture by
# reference and may assign, so a local a nested function writes to lives in a
# cell instead, and the closure captures the cell.

actor TemperCell do
  state value: Any :: nil
  on :get do reply value end
  on :set(v: Any) do
    become value: v
    reply nil
  end
end

def temper_new_cell(v: Any) -> Any do
  c = spawn TemperCell
  c <- :set(v)
  c
end

# ── Mutable strings ──────────────────────────────────
#
# StringBuilder is mutable for the same reason ListBuilder is, and gets the
# same answer: an actor holding the value.

actor TemperStringBuilder do
  state text: String :: ""

  on :__temper_types do reply [:StringBuilder] end
  on :text do reply text end
  on :toString do reply text end
  on :isEmpty do reply empty?(text) end

  # Temper's String indices are byte offsets, and `end` is one past the last.
  on :end do reply length(text) end

  on :append(s: String) do
    text = concat(text, s)
    become text: text
    reply nil
  end

  # Temper's appendCodePoint bubbles on anything that is not a code point:
  # past the maximum, or in the surrogate range, which UTF-8 never encodes.
  on :appendCodePoint(cp: Int) do
    case temper_is_code_point(cp) do
      true ->
        text = concat(text, u8_encode(cp))
        become text: text
        reply nil
      _ -> bubble :not_a_code_point
    end
  end

  on :appendBetween(source: String, from: Int, to: Int) do
    text = concat(text, temper_slice(source, from, to))
    become text: text
    reply nil
  end

  on :clear do
    become text: ""
    reply nil
  end
end

def temper_new_string_builder() -> Any do
  spawn TemperStringBuilder
end

# ── String indices ───────────────────────────────────
#
# A Temper StringIndex is a byte offset that has to land on the start of a
# UTF-8 sequence, so stepping is a sequence-width walk rather than arithmetic.

def temper_string_prev(s: String, i: Int) -> Int do
  temper_string_prev_loop(s, i - 1)
end

def temper_string_prev_loop(s: String, i: Int) -> Int do
  case i <= 0 do
    true -> 0
    _ -> case rem(char_code(s, i), 256) >= 128 and rem(char_code(s, i), 256) < 192 do
      true -> temper_string_prev_loop(s, i - 1)
      _ -> i
    end
  end
end

def temper_string_step(s: String, i: Int, by: Int) -> Int do
  case by == 0 do
    true -> i
    _ -> case by > 0 do
      true -> temper_string_step(s, temper_string_next(s, i), by - 1)
      _ -> temper_string_step(s, temper_string_prev(s, i), by + 1)
    end
  end
end

def temper_string_count_between(s: String, from: Int, to: Int) -> Int do
  temper_string_count_loop(s, from, to, 0)
end

def temper_string_count_loop(s: String, i: Int, to: Int, n: Int) -> Int do
  case i >= to or i >= length(s) do
    true -> n
    _ -> temper_string_count_loop(s, temper_string_next(s, i), to, n + 1)
  end
end

def temper_string_has_at_least(s: String, from: Int, to: Int, least: Int) -> Bool do
  temper_string_count_between(s, from, to) >= least
end

# Temper's String.begin is the index of the first code point. Blimp's string
# indices are byte offsets, so it is 0. It arrives as a static property read,
# which the backend flattens to this name.
static_String__begin = 0

# StringIndexOption is either a byte offset or the absence of one. Offsets are
# non-negative, and core.temper requires `none` to sort before every valid
# index, so -1 is the only value that can stand for it.
static_StringIndex__none = 0 - 1

def temper_is_code_point(cp: Int) -> Bool do
  case cp < 0 or cp > 1114111 do
    true -> false
    _ -> cp < 55296 or cp > 57343
  end
end

# Temper's reduce with no initial value folds from the first element, and
# bubbles on an empty sequence because there is nothing to start from.
def temper_reduce1(source: Any, f: Any) -> Any do
  items = temper_items(source)
  case empty?(items) do
    true -> temper_bubble()
    _ -> reduce(tail(items), head(items), f)
  end
end

def temper_reduce_from_index(source: Any, init: Any, index: Int, f: Any) -> Any do
  items = temper_items(source)
  reduce(temper_list_slice(items, index, length(items)), init, f)
end

# ── Maps ─────────────────────────────────────────────
#
# Blimp's own maps take string keys only, and Temper's take anything that is a
# MapKey, so a map here is an actor holding a list of [key, value] entries.
# Lookup is linear, which is honest rather than fast; a hashed version would
# need a hash Blimp does not expose.

actor TemperPair do
  state k: Any :: nil
  state v: Any :: nil
  on :__temper_types do reply [:Pair] end
  on :key do reply k end
  on :value do reply v end
  on :__new(key: Any, value: Any) do
    k = key
    v = value
    become k: k, v: v
    reply nil
  end
end

def temper_new_pair(key: Any, value: Any) -> Any do
  p = spawn TemperPair
  p <- :__new(key, value)
  p
end

actor TemperMap do
  state entries: List :: []

  on :__temper_types do reply [:Map, :MapBuilder, :Mapped] end
  on :entries do reply entries end
  on :length do reply length(entries) end
  on :isEmpty do reply empty?(entries) end
  on :keys do reply map(entries, fn(e: List) do elem(e, 0) end) end
  on :values do reply map(entries, fn(e: List) do elem(e, 1) end) end
  on :toList do reply map(entries, fn(e: List) do temper_new_pair(elem(e, 0), elem(e, 1)) end) end
  on :has(key: Any) do reply temper_entry_index(entries, key) >= 0 end

  on :get(key: Any) do
    i = temper_entry_index(entries, key)
    case i < 0 do
      true -> bubble :no_such_key
      _ -> reply elem(elem(entries, i), 1)
    end
  end

  on :getOr(key: Any, fallback: Any) do
    i = temper_entry_index(entries, key)
    case i < 0 do
      true -> reply fallback
      _ -> reply elem(elem(entries, i), 1)
    end
  end

  on :set(key: Any, value: Any) do
    i = temper_entry_index(entries, key)
    entries = case i < 0 do
      true -> append(entries, [key, value])
      _ -> set_at(entries, i, [key, value])
    end
    become entries: entries
    reply nil
  end

  on :remove(key: Any) do
    i = temper_entry_index(entries, key)
    case i < 0 do
      true -> bubble :no_such_key
      _ ->
        old = elem(elem(entries, i), 1)
        before = temper_list_slice(entries, 0, i)
        after = temper_list_slice(entries, i + 1, length(entries))
        entries = before ++ after
        become entries: entries
        reply old
    end
  end

  on :clear do
    become entries: []
    reply nil
  end

  on :forEach(body: Any) do
    temper_for_each(entries, fn(e: List) do body(elem(e, 0), elem(e, 1)) end)
    reply nil
  end

  on :copyFrom(other: Any) do
    entries = other <- :entries
    become entries: entries
    reply nil
  end
end

def temper_entry_index(entries: List, key: Any) -> Int do
  temper_entry_index_loop(entries, key, 0)
end

def temper_entry_index_loop(entries: List, key: Any, i: Int) -> Int do
  case i >= length(entries) do
    true -> 0 - 1
    _ -> case elem(elem(entries, i), 0) == key do
      true -> i
      _ -> temper_entry_index_loop(entries, key, i + 1)
    end
  end
end

def temper_new_map() -> Any do
  spawn TemperMap
end

# Temper's Map constructor also takes a list of Pairs. Blimp handlers have a
# fixed arity, so that shape gets its own helper rather than a default
# argument, and it fills by sending `:set` per pair instead of building the
# entry list in one handler: `:set` already replaces a duplicate key, and two
# `become`s in one handler would not compose anyway.
def temper_new_map_from(pairs: List) -> Any do
  m = spawn TemperMap
  temper_map_fill(m, pairs, 0)
end

def temper_map_fill(m: Any, pairs: List, i: Int) -> Any do
  case i >= length(pairs) do
    true -> m
    _ ->
      p = elem(pairs, i)
      m <- :set(p <- :key, p <- :value)
      temper_map_fill(m, pairs, i + 1)
  end
end

def temper_copy_map(source: Any) -> Any do
  m = spawn TemperMap
  m <- :copyFrom(source)
  m
end

def temper_map_to_list_with(source: Any, f: Any) -> List do
  map(source <- :entries, fn(e: List) do f(elem(e, 0), elem(e, 1)) end)
end

